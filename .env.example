# ===== 大模型密钥（至少配置你要用的那一家）=====
DOUBAO_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=

# 豆包（火山方舟）必须填你的推理接入点 ID 或模型名，例如 ep-2025xxxx 或 doubao-seed-1-6-250615
DOUBAO_MODEL=

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 建议后端写入用 service_role 密钥（不会暴露给前端），只填 anon key 也能跑，但需要放开 RLS
SUPABASE_SERVICE_ROLE_KEY=
